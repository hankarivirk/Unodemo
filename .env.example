# ==============================================================================
# Matcho! (Beta) / UNO Royale Telegram Mini App — Environment Configuration
# ==============================================================================
# Copy this file to `.env` for local development or future deployment.
# `server/index.js` automatically loads `.env` on startup via `server/env_loader.js`.
# NEVER commit your real `.env` file, database URLs, or secrets to version control.

# 1. Runtime Mode & Server Port
# Use NODE_ENV=development for local development and testing without live Telegram credentials.
# Use NODE_ENV=production when deploying publicly (enforces strict secret & origin checks).
NODE_ENV=development
PORT=3000

# 2. Local Development Authentication Flag
# Set ALLOW_DEV_AUTH=true ONLY during local development (`NODE_ENV=development`).
# Must be `false` in production (startup fails fast if enabled in production).
ALLOW_DEV_AUTH=true

# 3. Security Secrets (REQUIRED in production)
# SESSION_SECRET: At least 32 characters; signs stateless session tokens across restarts.
SESSION_SECRET=replace_with_a_64_char_random_hex_secret_for_signing_tokens_1234567890
# TELEGRAM_WEBHOOK_SECRET (alias WEBHOOK_SECRET): 16-256 characters; verified against
# Telegram's `X-Telegram-Bot-Api-Secret-Token` header on POST /api/bot/webhook.
TELEGRAM_WEBHOOK_SECRET=replace_with_telegram_webhook_secret_token_32chars
WEBHOOK_SECRET=replace_with_telegram_webhook_secret_token_32chars

# 4. Public URL & Trusted WebSocket Origins (REQUIRED in production)
# PUBLIC_APP_URL (alias WEBAPP_URL) is the public HTTPS URL where the Mini App is served.
PUBLIC_APP_URL=http://localhost:3000
WEBAPP_URL=http://localhost:3000
# Comma-separated list of allowed Origin headers for WebSocket upgrades:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 5. Telegram Bot & Mini App Configuration (from @BotFather — REQUIRED in production)
BOT_TOKEN=1234567890:AAF_replace_with_your_telegram_bot_token
BOT_USERNAME=matcho_bot
APP_SHORT_NAME=play

# 6. Multi-Database Selection & Provider Settings
# DATABASE_PROVIDER options:
#   - auto     (Priority: 1. Neon/PostgreSQL -> 2. MongoDB -> 3. SQLite -> 4. JSON)
#   - postgres (or `neon` — requires DATABASE_URL)
#   - mongodb  (requires MONGODB_URI)
#   - sqlite   (uses SQLITE_PATH)
#   - json     (uses DB_FILE_PATH)
DATABASE_PROVIDER=auto

# Option A: Neon PostgreSQL / Standard PostgreSQL (Priority 1)
# DATABASE_URL=postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: MongoDB Atlas / MongoDB (Priority 2)
# MONGODB_URI=mongodb+srv://db_user:db_password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=uno_royale

# Option C: SQLite Durable Local Database (Priority 3 — Recommended for local dev & single-node)
SQLITE_PATH=./data/uno_royale.sqlite

# Option D: Transactional JSON Fallback Store (Priority 4)
DB_FILE_PATH=./data/uno_royale_db.json

# Database Connection & Fallback Policy
# DB_AUTO_FALLBACK=true allows falling back to JSON in local development if a primary DB is unreachable.
# In production, keep DB_AUTO_FALLBACK=false so the server never silently switches to an empty JSON store.
DB_AUTO_FALLBACK=false
DB_CONNECTION_TIMEOUT_MS=5000

# 7. Optional Redis Cache & Coordination Layer (Independent of primary database)
# Caches rooms/players and coordinates locks; Redis outages degrade gracefully to the primary DB.
# REDIS_URL=redis://127.0.0.1:6379/0

# 8. Waiting Room Lobby Expiration Timeout (Default: 5 minutes = 300000 ms)
WAITING_ROOM_TIMEOUT_MS=300000
