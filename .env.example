# Required to validate Telegram Mini App initData in production and run the bot.
BOT_TOKEN=
BOT_USERNAME=

# Public HTTPS URL where this app is hosted. Telegram Web Apps require HTTPS.
PUBLIC_URL=https://your-domain.example
PORT=3000

# Development only: allows browser testing without Telegram login.
# MUST be false (or unset) in production.
DEV_ALLOW_GUESTS=true
NODE_ENV=development

# Optional: maximum age of Telegram initData in seconds (default 86400 / 24h).
INIT_DATA_MAX_AGE_SECONDS=86400
